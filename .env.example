# Server
PORT=3000

# SQLite database for recorded price history. Put it on a persistent disk in
# production (e.g. /var/data/clearance-tracker.db on Render).
DATABASE_PATH=data/clearance-tracker.db

# Walmart data source: "live" or "demo". Leave blank to go live automatically
# when the credentials below are set, and fall back to demo data otherwise.
WALMART_MODE=

# Walmart I/O Affiliate API credentials (required when WALMART_MODE=live)
# https://walmart.io/
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
# RSA private key registered with Walmart I/O: a file path, or the PEM itself
# (newlines may be written as \n) for hosts that only take env vars
WALMART_PRIVATE_KEY_PATH=./walmart_private_key.pem
WALMART_PRIVATE_KEY=
# Optional affiliate publisher id, appended to product links
WALMART_PUBLISHER_ID=
