# Server
PORT=3000

# Walmart data source: "demo" (default, synthetic data, no keys needed) or "live"
WALMART_MODE=demo

# Walmart I/O Affiliate API credentials (required when WALMART_MODE=live)
# https://walmart.io/
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=1
# Path to the RSA private key registered with Walmart I/O
WALMART_PRIVATE_KEY_PATH=./walmart_private_key.pem
# Optional affiliate publisher id, appended to product links
WALMART_PUBLISHER_ID=
